{
  "name": "project-panda",
  "private": true,
  "version": "1.0.0",
  "description": "Project Panda — Next-Generation Windows Desktop Communication App",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Project Panda Team",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.cjs",
    "start": "electron .",
    "app": "electron .",
    "build": "vite build",
    "build:vite": "vite build",
    "dist": "npm run build:vite && electron-builder --win",
    "make:exe": "npm run build:vite && electron-builder --win nsis",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.projectpanda.app",
    "productName": "Project Panda",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Project Panda"
    }
  },
  "dependencies": {
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.27.0",
    "multer": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
